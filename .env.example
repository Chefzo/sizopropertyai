# SiZo Agent — environment config
# Copy to .env and fill in. MOCK=true runs the whole loop with no external services.

MOCK=true
PORT=3000

# Claude (the brain)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CONFIDENCE_FLOOR=0.75

# Hospitable (PMS layer — owns the Airbnb/VRBO connection)
HOSPITABLE_API_KEY=

# Map Hospitable listing IDs -> knowledge file slugs in /properties
UNIT_MAP={"123456":"pilot-unit"}

# Airtable (ops base / source of truth)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Twilio (Sienna's escalation SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
SIENNA_PHONE=

# Resident line: map tenant phones -> unit + name (one entry per tenant phone)
TENANT_MAP={"+1502FILL0001":{"unit":"payne-1304","name":"Erin"},"+1502FILL0002":{"unit":"payne-1306","name":"Anna"},"+1502FILL0003":{"unit":"payne-1306","name":"Max"},"+1502FILL0004":{"unit":"malcolm-607","name":"Erica"},"+1502FILL0005":{"unit":"malcolm-607","name":"Corey"},"+1502FILL0006":{"unit":"walbridge-11001","name":"Leanna"}}
